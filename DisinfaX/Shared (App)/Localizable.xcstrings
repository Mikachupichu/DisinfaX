    "Or right-click the selected text and choose Disinfact (also works on unselected text)." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of regskliek op die gekose teks en kies Verifieer (werk ook op ongeselekteerde teks)."
          }
        },
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana fa nifa so ka nsɛm a wɔapaw no so na paw Da Adi (ɛsan yɛ adwuma wɔ nsɛm a wɔmpaw so)."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ወይም በተመረጠው ጽሑፍ ላይ በቀኝ ጠቅ ያድርጉ እና አጣራ ን ይምረጡ (በማይመረጥ ጽሑፍ ላይም ይሠራል)።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U clica con o botón dreito sobre o texto seleccionau y triga Verificar (tamién funciona con texto no seleccionau)."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو انقر بزر الماوس الأيمن على النص المحدَّد واختر تحقق (يعمل أيضًا مع النص غير المحدَّد)."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বা বাছনি কৰা পাঠটোত ৰাইট-ক্লিক কৰি পৰীক্ষা কৰক বাছক (বাছনি নকৰা পাঠতো কাম কৰে)।"
          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fai clic col botón derechu sobre'l testu seleicionáu y escueyi Disinfact (tamién funciona col testu ensin seleicionar)."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Və ya seçilmiş mətnə sağ klikləyin və Yoxla seçin (seçilməmiş mətndə də işləyir)."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або пстрыкніце правай кнопкай мышы па выдзеленым тэксце і выберыце Праверыць (працуе і на невыдзеленым тэксце)."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или щракнете с десен бутон върху избрания текст и изберете Провери (работи и върху неизбран текст)."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অথবা নির্বাচিত টেক্সটে রাইট-ক্লিক করে যাচাই করুন বেছে নিন (অনির্বাচিত টেক্সটেও কাজ করে)।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe klikit gant ar bouton dehou war an destenn diuzet ha dibabit Difalsaat (a ra ivez war an destenn nann-diuzet)."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili kliknite desnim tasterom na odabrani tekst i odaberite Otkrij (radi i na tekstu koji nije odabran)."
          }
        },
        "ca" : {
          "stringUnit" : {
