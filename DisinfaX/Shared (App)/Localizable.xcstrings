        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অথবা নির্বাচিত টেক্সটে রাইট-ক্লিক করে যাচাই করুন বেছে নিন (অনির্বাচিত টেক্সটেও কাজ করে)।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe klikit gant ar bouton dehou war an destenn diuzet ha dibabit Difalsaat (a ra ivez war an destenn nann-diuzet)."
