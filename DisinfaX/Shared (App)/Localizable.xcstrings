        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אויפלאָדן דאַרפֿן אַ נייערע ווערסיע פֿון macOS. פֿרישט אויף, און דערנאָך עפֿנט DisinfaX נאָך אַ מאָל."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àwọn ìkówó nílò ẹ̀dà macOS tuntun. Ṣàtúnbọ̀, lẹ́yìn náà ṣí DisinfaX padà."
