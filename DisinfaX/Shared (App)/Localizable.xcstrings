        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Со кликнување на %@ се откриваат тврдења и ќе се наплати од вашето салдо"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ക്ലിക്ക് ചെയ്യുന്നത് അവകാശവാദങ്ങൾ വെളിപ്പെടുത്തുകയും നിങ്ങളുടെ ബാലൻസിൽ നിന്ന് ഈടാക്കുകയും ചെയ്യും"
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ дээр дарахад мэдэгдлүүд харагдах бөгөөд таны балансаас мөнгө шимтгэгдэнэ"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ क्लिक केल्याने दावे उघड होतील आणि तुमच्या शिल्लक रकमेतून पैसे कापले जातील"
