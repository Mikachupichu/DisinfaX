    "Return the claims alone, without researching any of them." : {
      "comment" : "Whether to skip fact-checking and return just the claims.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gee net die bewerings terug, sonder om enige daarvan na te vors."
          }
        },
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma nsɛm no nko ara mmra, na hwɛ mu biara nni hɔ."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መግለጫዎቹን ብቻ መልስ፣ ምንም ሳይመረምር።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devolver nomás as afirmacions, sin investigar-ne garra."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعِد الادعاءات فقط، دون البحث في أي منها."
