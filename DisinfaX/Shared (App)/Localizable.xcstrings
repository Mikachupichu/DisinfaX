          "stringUnit" : {
            "state" : "translated",
            "value" : " i te paewhāititanga, ka pāwhiri i te Whakahaere Toronga ā ka whakahohe i a DisinfaX."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " во адресната лента, потоа допрете Управувај со проширувања и овозможете DisinfaX."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ഐക്കണിൽ ടാപ്പ് ചെയ്യുക, തുടർന്ന് എക്സ്റ്റൻഷനുകൾ കൈകാര്യം ചെയ്യുക എന്നതിൽ ടാപ്പ് ചെയ്ത് DisinfaX പ്രവർത്തനക്ഷമമാക്കുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " дүрс тэмдгийг товшиж, дараа нь Өргөтгөл удирдах-ыг товшиж DisinfaX-ийг асаана уу."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " चिन्हावर टॅप करा, नंतर एक्स्टेंशन्स व्यवस्थापित करा वर टॅप करा आणि DisinfaX सक्षम करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " pada bar alamat, kemudian ketik Urus Sambungan dan dayakan DisinfaX."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " fil-bar tal-indirizz, imbagħad mess Ġestjoni tal-Estensjonijiet u attiva DisinfaX."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " သင်္ကေတကို တို့ပြီး၊ ထို့နောက် တိုးချဲ့စနစ်များကို စီမံရန် ကို တို့ကာ DisinfaX ကိုဖွင့်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-ikonet i adressefeltet, trykk deretter på Administrer utvidelser, og aktiver DisinfaX."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " आइकनमा ट्याप गर्नुहोस्, त्यसपछि एक्सटेन्सनहरू व्यवस्थापन गर्नुहोस्मा ट्याप गर्नुहोस् र DisinfaX सक्षम गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-symbool in de adresbalk, tik dan op Extensies beheren en schakel DisinfaX in."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-ikonet i adressefeltet, trykk deretter på Administrer utvidelser, og aktiver DisinfaX."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " pa bala la adilesi, kenako khudzani Sinthani Zowonjezera ndikuyatsa DisinfaX."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " kan sararaa teessoo keessatti tuqi, ergasii Dabalataalee Bulchi tuqiitii DisinfaX dandeessisi."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ଆଇକନ୍ କୁ ଟାପ୍ କରନ୍ତୁ, ତାପରେ ଏକ୍ସଟେନ୍ସନ୍ସ ପରିଚାଳନା କରନ୍ତୁ ଟାପ୍ କରି DisinfaX କୁ ସକ୍ଷମ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ਆਈਕਨ 'ਤੇ ਟੈਪ ਕਰੋ, ਫਿਰ ਐਕਸਟੈਂਸ਼ਨਾਂ ਦਾ ਪ੍ਰਬੰਧਨ ਕਰੋ 'ਤੇ ਟੈਪ ਕਰੋ ਅਤੇ DisinfaX ਨੂੰ ਸਮਰੱਥ ਬਣਾਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " na pasku adresu, następnie stuknij Zarządzaj rozszerzeniami i włącz DisinfaX."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " کېکاږئ، بیا توسیعې اداره کړئ کېکاږئ او DisinfaX فعال کړئ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " na barra de endereço, depois toca em Gerir Extensões e ativa o DisinfaX."
          }
        },
        "pt_BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " na barra de endereço, depois toque em Gerenciar Extensões e ative o DisinfaX."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " na barra de endereço, depois toca em Gerir Extensões e ativa o DisinfaX."
          }
        },
        "qu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " adiris qhawachiypi, chaymantataq Yapaykunata Kamachiyta tuqyay hinaspa DisinfaX-ta kallpachay."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " en la trav d'adressa, lura tutga Administrar extensiuns ed activescha DisinfaX."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " din bara de adrese, apoi atinge Gestionare extensii și activează DisinfaX."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " в адресной строке, затем коснитесь «Управление расширениями» и включите DisinfaX."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ku murongo w'aderesi, hanyuma ukande Gucunga Ibyongerwaho hanyuma wemerere DisinfaX."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " تي ٽيپ ڪريو، پوءِ ايڪسٽينشن مئنيج ڪريو تي ٽيپ ڪريو ۽ DisinfaX کي فعال ڪريو."
          }
        },
        "sh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " u adresnoj traci, zatim dodirnite Upravljanje proširenjima i omogućite DisinfaX."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " නිරූපකය තට්ටු කර, පසුව දිගු කළමනාකරණය කරන්න තට්ටු කර DisinfaX සබල කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " na paneli s adresou, potom klepnite na Spravovať rozšírenia a povoľte DisinfaX."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " v naslovni vrstici, nato se dotaknite Upravljanje razširitev in omogočite DisinfaX."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " i le pusa tuatusi, ona tapi lea o Fa'atonutonu Fa'alauteleina ma fa'agaoioia DisinfaX."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " mumutsara wekero, wobva wabaya Tonga Zvidzikisirwo wobva wabatidza DisinfaX."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ee usha ciwaanka, ka dib taabo Maamul Kordhinta oo shid DisinfaX."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " në shiritin e adresave, pastaj trokit Menaxho Zgjerimet dhe aktivizo DisinfaX."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " у адресној траци, затим додирните Управљај екстензијама и омогућите DisinfaX."
          }
        },
        "st" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " bareng ea aterese, ebe u tobetsa Laola Ditlatsetso ebe u nolofatsa DisinfaX."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " dina bar alamat, teras toél Kelola Éksténsi sareng aktipkeun DisinfaX."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-ikonen i adressfältet, tryck sedan på Hantera tillägg och aktivera DisinfaX."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " kwenye upau wa anwani, kisha gonga Dhibiti Viendelezi na uwezeshe DisinfaX."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ஐகானைத் தட்டவும், பிறகு நீட்டிப்புகளை நிர்வகி என்பதைத் தட்டி DisinfaXஐ இயக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " చిహ్నాన్ని నొక్కి, తర్వాత పొడిగింపులను నిర్వహించండి నొక్కి DisinfaXను ప్రారంభించండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " дар сатри нишонӣ зарба занед, сонӣ ба «Идоракунии пасвандҳо» зарба занед ва DisinfaX-ро фаъол кунед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ในแถบที่อยู่ จากนั้นแตะจัดการส่วนขยายและเปิดใช้งาน DisinfaX"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ጠውቕ፣ ድሕሪኡ Manage Extensions ጠውቕ ከምኡ DisinfaX ኣወለው።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " nyşanyna basyň, soňra Giňeltmeleri Dolandyr-a basyp DisinfaX-y işjeňleşdiriň."
          }
        },
        "tn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " mo bareng ya atirese, go tswa foo o tobetse Laola Ditlatsetso mme o nolofatse DisinfaX."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ʻi he vā tuʻasila, pea toki tuki e Puleʻi ʻa e Ngaahi Fakaʻāofi mo fakaava ʻa DisinfaX."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " simgesine dokunun, ardından Uzantıları Yönet'e dokunun ve DisinfaX'i etkinleştirin."
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " символга басыгыз, аннары Киңәйтүләрне Идарә Итү-гә басып DisinfaX-ны кабызыгыз."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " چېكىڭ، ئاندىن كېڭەيتىلمىلەرنى باشقۇرۇشنى چېكىپ DisinfaX نى قوزغىتىڭ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " в адресному рядку, потім торкніться «Керувати розширеннями» та увімкніть DisinfaX."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " آئیکن پر تھپتھپائیں، پھر ایکسٹینشنز کا نظم کریں پر تھپتھپائیں اور DisinfaX کو فعال کریں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " belgisiga bosing, so'ng Kengaytmalarni boshqarish'ga bosing va DisinfaX'ni yoqing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " trên thanh địa chỉ, sau đó chạm vào Quản lý tiện ích mở rộng và bật DisinfaX."
          }
        },
        "wa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " dins l' bår d' adresse, adon tchôkîz so Manaedjî les Ekstinsions eyet metoz DisinfaX en alaedje."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " kwibha yedilesi, emva koko ucofe Lawula Izongezelelo uze uvule amandla i-DisinfaX."
          }
        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " אין דעם אַדרעס באר, דערנאָך טאַפּט פאַרוואַלטן אויסברייטערונגען און שטעלט אָן DisinfaX."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " tí ó wà ní ọ̀pá àdírẹ́sì, lẹ́yìn náà tẹ Ṣàkóso Àwọn Àfikún kí o sì mú DisinfaX ṣiṣẹ́."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图标，然后点按“管理扩展”并启用 DisinfaX。"
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图标，然后点按“管理扩展”并启用 DisinfaX。"
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖示，接著點一下「管理延伸功能」並啟用 DisinfaX。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖示，接著點一下「管理延伸功能」並啟用 DisinfaX。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " kubha wekheli, bese uthepha Phatha Izenezelo bese unika amandla i-DisinfaX."
          }
        }
      }
