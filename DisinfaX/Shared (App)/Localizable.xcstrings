        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utawa klik-tengen teks sing dipilih lan pilih Priksa (uga bisa digunakake ing teks sing ora dipilih)."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ან დააწკაპუნეთ მარჯვენა ღილაკით არჩეულ ტექსტზე და აირჩიეთ გამოვლენა (მუშაობს ასევე არარჩეულ ტექსტზე)."
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neɣ sit s ufus ayeffus ɣef uḍris yettwafren syin tferneḍ Senqed (yetteddu daɣen ɣef uḍris ur nettwafern ara)."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немесе таңдалған мәтінді тінтуірдің оң жақ түймесімен басып, Тексеру таңдаңыз (таңдалмаған мәтінде де жұмыс істейді)."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ឬចុចស្តាំលើអត្ថបទដែលបានជ្រើសរើស ហើយជ្រើសរើស ត្រួតពិនិត្យ (ដំណើរការផងដែរលើអត្ថបទដែលមិនបានជ្រើសរើស)។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಥವಾ ಆಯ್ಕೆಮಾಡಿದ ಪಠ್ಯದಲ್ಲಿ ಬಲ-ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು ಪರಿಶೀಲಿಸಿ ಆಯ್ಕೆಮಾಡಿ (ಆಯ್ಕೆಮಾಡದ ಪಠ್ಯದಲ್ಲಿಯೂ ಕೆಲಸ ಮಾಡುತ್ತದೆ)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 선택한 텍스트를 오른쪽 클릭하고 팩트체크를 선택하세요(선택하지 않은 텍스트에서도 작동합니다)."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An jî rast-klîk li nivîsa hilbijartî bike û Kontrol hilbijêre (li ser nivîsa nehilbijartî jî kar dike)."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Же тандалган текстти оң баскыч менен басып, Текшерүү тандаңыз (тандалбаган текстте да иштейт)."
          }
        },
        "la" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vel tange dextro musculo textum electum et elige Recognosce (etiam in textu non electo valet)."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder méch engem Rietsklick op den ausgewielten Text a wielt Iwwerpréifung (funktionéiert och op net ausgewieltem Text)."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຫຼືຄລິກຂວາໃສ່ຂໍ້ຄວາມທີ່ເລືອກ ແລ້ວເລືອກ ກວດສອບ (ໃຊ້ໄດ້ກັບຂໍ້ຄວາມທີ່ບໍ່ໄດ້ເລືອກນຳ)."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arba dešiniuoju pelės mygtuku spustelėkite pažymėtą tekstą ir pasirinkite Tikrinti (veikia ir nepažymėtam tekstui)."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai arī noklikšķiniet ar peles labo pogu uz atlasīto tekstu un izvēlieties Pārbaudīt (darbojas arī ar neatzīmētu tekstu)."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kitiho amin'ny bokotra havanana amin'ny lahatsoratra voafidy dia safidio ny Manamarina (miasa koa amin'ny lahatsoratra tsy voafidy)."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rānei, pāwhiritia te pāwhiri-matau ki te kuputuhi kua tōia, ka kōwhiri i a Arotake (ka mahi hoki ki te kuputuhi kāore anō kia tōia)."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или кликнете со десното копче на избраниот текст и изберете Проверка (работи и на неизбран текст)."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അല്ലെങ്കിൽ തിരഞ്ഞെടുത്ത ടെക്സ്റ്റിൽ റൈറ്റ്-ക്ലിക്ക് ചെയ്ത് പരിശോധന തിരഞ്ഞെടുക്കുക (തിരഞ്ഞെടുക്കാത്ത ടെക്സ്റ്റിലും പ്രവർത്തിക്കും)."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эсвэл сонгосон текст дээр хулганы баруун товчийг дараад Шалгалт-г сонгоно уу (сонгоогүй текст дээр ч ажиллана)."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किंवा निवडलेल्या मजकुरावर राइट-क्लिक करा आणि तपासणी निवडा (न निवडलेल्या मजकुरावरही काम करते)."
