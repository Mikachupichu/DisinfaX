        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट कधी लिहिली किंवा शेवटची संपादित केली: वर्ष (2020), महिना (2020-04), किंवा तारीख (2020-04-07). तिचे दावे आजऐवजी त्या तारखेनुसार तपासले जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bila siaran ditulis atau kali terakhir disunting: tahun (2020), bulan (2020-04), atau tarikh (2020-04-07). Dakwaannya dinilai setakat tarikh itu, bukan hari ini."
