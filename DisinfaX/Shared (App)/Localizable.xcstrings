            "value" : "%@ ஐக் கிளிக் செய்தால் கூற்றுகள் வெளிப்படும், மேலும் உங்கள் இருப்புத்தொகையிலிருந்து கட்டணம் வசூலிக்கப்படும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ క్లిక్ చేయడం వాదనలను చూపిస్తుంది మరియు మీ బ్యాలెన్స్ నుండి రుసుము వసూలు చేస్తుంది"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клик кардан ба %@ даъвоҳоро ошкор мекунад ва аз бақияи шумо маблағ гирифта мешавад"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การคลิก %@ จะเปิดเผยข้อกล่าวอ้างและจะหักเงินจากยอดคงเหลือของคุณ"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብ %@ ምጥዋቕ ነቶም መግለጺታት የርኢ እሞ ካብ ሒሳብካ ገንዘብ ክቕነስ እዩ"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ üstüne basmak beýanlary ýüze çykarar we balansyňyzdan pul tutar"
          }
        },
        "tn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go tobetsa %@ go bontsha dikgato mme go tla lefisa madi mo tekanyetsong ya gago"
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko hono lomi ʻo e %@ ʻe fakahā ai ʻa e ngaahi fakamatala pea ʻe utu ai hoʻo toenga paʻanga"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ simgesine tıklamak iddiaları gösterir ve bakiyenizden ücret düşer"
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ төймәсенә басу дәгъвәләрне күрсәтә һәм балансыгыздан акча алыначак"
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نى چېكىش دەۋالارنى ئاشكارىلايدۇ ھەمدە قالدۇقىڭىزدىن پۇل تۇتۇپ قالىدۇ"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Натискання на %@ показує твердження і спише кошти з вашого балансу"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ پر کلک کرنے سے دعوے ظاہر ہوں گے اور آپ کے بیلنس سے رقم کٹے گی"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tugmasini bosish da'volarni ko'rsatadi va balansingizdan pul yechiladi"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp vào %@ sẽ hiển thị các tuyên bố và trừ tiền vào số dư của bạn"
          }
        },
        "wa" : {
          "stringUnit" : {
            "state" : "translated",
