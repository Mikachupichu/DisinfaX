            "value" : "Ou fai clic co botón dereito sobre o texto seleccionado e escolle Verificar (tamén funciona con texto non seleccionado)."
          }
        },
        "gn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Térã eikutu akatúa rehe jehaipy ojeiporavóva ha eiporavo Jehechakuaa (ojejapo avei jehaipy ndojeiporavóivape)."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અથવા પસંદ કરેલા ટેક્સ્ટ પર જમણું ક્લિક કરો અને ચકાસણી પસંદ કરો (ન પસંદ કરેલા ટેક્સ્ટ પર પણ કામ કરે છે)."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko kuma danna da maɓallin dama kan rubutun da aka zaɓa sannan ka zaɓi Bincike (yana aiki kuma a kan rubutun da ba a zaɓa ba)."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A i ʻole, kaomi ʻākau i ke kikokikona i koho ʻia a koho iā Hōʻoia (hana pū me ke kikokikona i koho ʻole ʻia)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לחילופין, לחץ לחיצה ימנית על הטקסט המסומן ובחר בדיקה (פועל גם על טקסט לא מסומן)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या चयनित टेक्स्ट पर राइट-क्लिक करें और जाँच चुनें (बिना चयनित टेक्स्ट पर भी काम करता है)।"
          }
        },
        "hmn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nias rau sab xis ntawm cov ntawv uas xaiv lawm thiab xaiv Tshawb Xyuas (ua haujlwm kuj rau cov ntawv uas tsis tau xaiv)."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili kliknite desnim tasterom na odabrani tekst i odaberite Provjeri (radi i na tekstu koji nije odabran)."
          }
        },
        "hsb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abo klikń z prawym tastom na wubrany tekst a wubjer Pruwowanje (funguje tež na njewubranym teksće)."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oswa fè yon klik dwa sou tèks seleksyone a epi chwazi Verifye (li fonksyone tou sou tèks ki pa seleksyone)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagy kattints jobb gombbal a kijelölt szövegre, és válaszd a Ellenőrzés lehetőséget (nem kijelölt szövegen is működik)."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Կամ աջ սեղմեք ընտրված տեքստի վրա և ընտրեք Ստուգում (աշխատում է նաև չընտրված տեքստի վրա)։"
          }
        },
        "ia" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O face clic dextre sur le texto seligite e selige Verificar (functiona etiam sur texto non seligite)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau klik kanan teks yang dipilih dan pilih Cek Fakta (juga berfungsi pada teks yang tidak dipilih)."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma ọ bụ pịa aka nri na ederede ahọpụtara wee họrọ Nyochaa (ọ na-arụkwa ọrụ na ederede a họpụtaghị)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eða hægrismelltu á valinn textann og veldu Staðfesta (virkar líka á óvalinn texta)."
