        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "វគ្គបន្ទាប់ពីអត្ថបទ ប្រើតែដើម្បីកំណត់ថាតើការអះអាងទទេៗសំដៅលើអ្វី។ មិនដែលផ្ទៀងផ្ទាត់ខ្លួនឯងឡើយ។"
