        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite pravým tlačidlom na vybratý text a vyberte Overiť (funguje aj na nevybratom texte)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite z desno tipko miške na izbrano besedilo in izberite Razkrij (deluje tudi na neizbranem besedilu)."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiliki i le kiʻi taumatau i le tusitusiga ua filifilia ona filifili lea o le Fa'aali (e aoga foʻi i le tusitusiga e leʻi filifilia)."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baya neki yesu kurudyi pachinyorwa chasarudzwa wobva wasarudza Ongorora chokwadi (inoshandawo pachinyorwa chisina kusarudzwa)."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taabo badhanka midig ee qoraalka la doortay ka dibna dooro Xaqiiji (waxay sidoo kale ka shaqeysaa qoraal aan la dooran)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliko me të djathtën mbi tekstin e zgjedhur dhe zgjidh Disinfakto (funksionon edhe për tekst të pazgjedhur)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кликните десним тастером миша на изабрани текст и изаберите Откриј (ради и на неизбраном тексту)."
          }
        },
        "st" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tobetsa ho konopo e ka ho le letona ya mongolo o khethiloeng ebe u khetha Hlahloba (e sebetsa le mongolong o sa khethoang)."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik-katuhu téks anu dipilih teras pilih Pariksa (ogé tiasa dianggo dina téks anu henteu dipilih)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerklicka på den markerade texten och välj Disinfact (fungerar även på text som inte är markerad)."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bofya kwa kitufe cha kulia kwenye maandishi yaliyochaguliwa kisha uchague Disinfact (inafanya kazi pia kwenye maandishi ambayo hayajachaguliwa)."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தேர்ந்தெடுத்த உரையில் வலது கிளிக் செய்து உண்மை சரிபார்ப்பு தேர்ந்தெடுக்கவும் (தேர்ந்தெடுக்காத உரையிலும் வேலை செய்யும்)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఎంచుకున్న వచనంపై కుడి-క్లిక్ చేసి వాస్తవ తనిఖీను ఎంచుకోండి (ఎంచుకోని వచనంపైనా పని చేస్తుంది)."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бо тугмаи рости муш дар матни интихобшуда зер кунед ва Ошкор кардан-ро интихоб кунед (дар матни интихобнашуда ҳам кор мекунад)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกขวาที่ข้อความที่เลือกแล้วเลือก ตรวจสอบข้อเท็จจริง (ใช้ได้กับข้อความที่ไม่ได้เลือกด้วย)"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ኣብቲ ተመሪጹ ዘሎ ጽሑፍ ቀኝ-ክሊክ ጠውቕ እሞ ግለጽ ምረጽ (ኣብ ዘይተመርጸ ጽሑፍ እውን ይሰርሕ)።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saýlanan tekste sag düwmä basyň we Barla saýlaň (saýlanmadyk tekstde hem işleýär)."
          }
        },
        "tn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tobetsa ka konopo ya moja e e kafa mo le letona mo mokwalong o o tlhophilweng mme o tlhophe Tlhatlhoba (e dira gape mo mokwalong o o sa tlhophiwang)."
