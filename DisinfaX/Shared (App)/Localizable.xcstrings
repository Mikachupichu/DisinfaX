            "value" : "Atau klik kanan teks yang dipilih dan pilih Pemeriksaan (juga berfungsi pada teks yang tidak dipilih)."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jew ikklikkja bil-lemin fuq it-test magħżul u agħżel Verifika (jaħdem ukoll fuq test mhux magħżul)."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သို့မဟုတ် ရွေးထားသော စာသားပေါ်တွင် ညာကလစ်နှိပ်ပြီး စစ်ဆေးခြင်း ကို ရွေးပါ (မရွေးထားသော စာသားတွင်လည်း အလုပ်လုပ်ပါသည်)။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller høyreklikk på den markerte teksten og velg Kontroll (fungerer også på tekst som ikke er markert)."
