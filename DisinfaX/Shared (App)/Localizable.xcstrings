    "With the text still selected, click the DisinfaX icon in the Safari toolbar to open the popup." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terwyl die teks steeds gekies is, tik op die DisinfaX-ikoon in Safari se nutsbalk om die opspringvenster te open."
          }
        },
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bere a wɔapaw nsɛm no da so ara, ka DisinfaX sɛnkyerɛnne no wɔ Safari nnwinnade dua no so na bue pop-up no."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ጽሑፉ አሁንም ተመርጦ ሳለ ብቅ ባይ መስኮቱን ለመክፈት በ Safari የመሣሪያ አሞሌ ውስጥ ያለውን የDisinfaX አዶ ይንኩ።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con o texto encara seleccionau, toca l'icono de DisinfaX en a barra de ferramientas de Safari pa ubrir a finestra emerchent."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع بقاء النص محدَّدًا، اضغط على أيقونة DisinfaX في شريط أدوات Safari لفتح النافذة المنبثقة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাঠটো এতিয়াও নিৰ্বাচিত ৰাখি পপআপ খুলিবলৈ Safari টুলবাৰত থকা DisinfaX চিহ্নত টিপক।"
          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Col testu entá seleicionáu, toca l'iconu de DisinfaX na barra de ferramientes de Safari p'abrir la ventana emerxente."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mətn seçili qalsa, pop-up pəncərəsini açmaq üçün Safari-nin alət panelindəki DisinfaX ikonasına klikləyin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не здымаючы выдзяленне, націсніце на значок DisinfaX на панэлі інструментаў Safari, каб адкрыць усплывальнае акно."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без да премахвате селекцията, щракнете върху иконата на DisinfaX в лентата с инструменти на Safari, за да отворите изскачащия прозорец."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টেক্সটটি এখনও নির্বাচিত রেখে পপআপ খুলতে Safari টুলবারে DisinfaX আইকনে ট্যাপ করুন।"
