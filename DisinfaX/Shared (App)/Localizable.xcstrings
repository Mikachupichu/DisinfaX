        "la" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ premendo assertiones revelabuntur et saldum tuum onerabitur"
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann Dir op %@ klickt, ginn d'Behaaptungen ugewisen a vun Ärem Saldo ofgezunn"
