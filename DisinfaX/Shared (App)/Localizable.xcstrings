        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاللانغان تېكىستنى ئوڭ چېكىپ ئاشكارىلاش نى تاللاڭ (تاللانمىغان تېكىستكىمۇ ئىشلەيدۇ)."
