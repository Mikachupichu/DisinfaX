        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ավելի վաղ US$%lld գնումը դեռ սպասում էր կիրառման, ուստի հենվեց դա, փոխանակ ձեզից կրկին գումար գանձելու։ Վերադարձեք Safari և բացեք DisinfaX-ի ելնող պատուհանը՝ ձեր թարմացված հաշվեկշիռը տեսնելու համար։"
