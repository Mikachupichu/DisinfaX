    "Your balance is too low. Please top up to continue." : {
      "comment" : "A message that is shown when the user's balance is too low.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jou saldo is te laag. Laai asseblief op om voort te gaan."
          }
        },
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W'akontaa mu sika sua dodo. Yɛsrɛ wo, fa sika gu mu na woatoa so."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ቀሪ ሂሳብዎ በጣም ዝቅተኛ ነው። ለመቀጠል እባክዎ ሂሳብዎን ይሙሉ።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tuyo saldo ye masiau baixo. Recarga ta continar."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رصيدك منخفض جدًا. يُرجى شحن الرصيد للمتابعة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপোনাৰ ব্যালেন্স বহুত কম। অনুগ্ৰহ কৰি অব্যাহত ৰাখিবলে টপ আপ কৰক।"
          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El to saldu ye demasiáu baxu. Recarga pa siguir, por favor."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balansınız kifayət qədər deyil. Davam etmək üçün balansı artırın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш баланс занадта нізкі. Папаўніце баланс, каб працягнуць."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Балансът ви е твърде нисък. Захранете баланса си, за да продължите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ব্যালেন্স খুব কম। চালিয়ে যেতে অনুগ্রহ করে টপ আপ করুন।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
