    " icon in the address bar, then Manage Extensions, and turn on DisinfaX." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "-ikoon in die adresbalk, tik dan op Bestuur Uitbreidings en aktiveer DisinfaX."
          }
        },
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " a ɛwɔ address dua no so, ɛno akyi ka Nkekaho Hwɛ so na ma DisinfaX yɛ adwuma."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " አዶ ይንኩ፣ ከዚያ ቅጥያዎችን ያስተዳድሩ ን ይንኩ እና DisinfaX ን ያንቁ።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " en a barra de directions, dimpués toca Chestionar Extensions e activa DisinfaX."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " في شريط العنوان، ثم اضغط على إدارة الإضافات وفعّل DisinfaX."
          }
        },
        "ar_XB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " في شريط العنوان، ثم اضغط على إدارة الإضافات وفعّل DisinfaX."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " চিহ্নত টিপক, তাৰ পিছত এক্সটেনশ্যনসমূহ পৰিচালনা কৰকত টিপি DisinfaX সক্ষম কৰক।"
          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " na barra de direiciones, dempués toca Xestionar Estensiones y activa DisinfaX."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " ikonuna toxunun, sonra Genişləndirmələri idarə et-ə toxunun və DisinfaX-i aktivləşdirin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " у адрасным радку, потым дакраніцеся да «Кіраваць пашырэннямі» і ўключыце DisinfaX."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " в адресната лента, след което докоснете „Управление на разширенията“ и активирайте DisinfaX."
          }
        },
        "bh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " आइकन पर टैप करें, फिर एक्सटेंशन प्रबंधित करें पर टैप करें और DisinfaX सक्षम करें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " আইকনে ট্যাপ করুন, তারপর এক্সটেনশন পরিচালনা করুন-এ ট্যাপ করুন এবং DisinfaX সক্ষম করুন।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " e barrenn ar chomlec'h, ha goude-se stokit war Merañ an Astennoù ha gweredekait DisinfaX."
