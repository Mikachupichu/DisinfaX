        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वा चयन गरिएको पाठमा राइट-क्लिक गरी जाँच छनौट गर्नुहोस् (नचयन गरिएको पाठमा पनि काम गर्छ)।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of klik met de rechtermuisknop op de geselecteerde tekst en kies Controleren (werkt ook op niet-geselecteerde tekst)."
