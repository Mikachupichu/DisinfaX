        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustelėjus %@ atskleidžiami teiginiai ir bus nuskaičiuota nuo tavo balanso"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noklikšķinot uz %@ tiks atklāti apgalvojumi un no tava atlikuma tiks noņemta maksa"
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny fanindriana ny %@ dia hampiseho ny filazana ary hisy sarany hesorina amin'ny volanao"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te pāwhiri i te %@ ka whakaatu i ngā kerēme, ā, ka utua tō toenga"
