        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwenzeke impazamo ngasecaleni kwethu. Nceda uzame kwakhona kungekudala."
          }
        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אַ טעות איז געשען אויף אונדזער זײַט. ביטע פּרוּווט נאָך אַ מאָל אין אַ מינוט."
