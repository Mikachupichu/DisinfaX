        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "එම ගාස්තු එකතු කිරීමේ ප්‍රමාණය වැරදිය. කරුණාකර වෙනත් ප්‍රමාණයක් තෝරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
