        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຫຼາກຄວາມຫຼັງຂໍ້ຄວາມ, ໃຊ້ພຽງເພື່ອກຳນົດວ່າຂໍ້ກ່າວອ້າງເປົ່າຯ ໝາຍເຖິງສິ່ງໃດ. ບໍ່ເຄີຍຖືກກວດສອບຕົວມັນເອງ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstui po einanti ištrauka, naudojama tik nustatyti, į ką nurodo plikas teiginys. Pati niekada netikrinama."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
