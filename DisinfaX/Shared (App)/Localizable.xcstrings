        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àṣìṣe kan ṣẹlẹ̀ ní ẹ̀gbẹ́ wa. Jọ̀wọ́ tún gbìyànjú láìpẹ́."
