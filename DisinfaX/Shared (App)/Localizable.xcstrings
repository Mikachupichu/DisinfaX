    "Top-ups need a newer version of iOS. Update, then reopen DisinfaX." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplaaie benodig 'n nuwer weergawe van iOS. Werk by, en open dan DisinfaX weer."
          }
        },
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sika a wɔde bɛtɔ mu no hia iOS foforo. Yɛ update, ɛno akyi bue DisinfaX bio."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መሙላቶች የ iOS አዲስ ስሪት ይፈልጋሉ። ያዘምኑ፣ ከዚያ DisinfaX ን እንደገና ይክፈቱ።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As recargas requieren una versión mas nueva d'iOS. Esviella, e dimpués ubre de nuevo DisinfaX."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب عمليات الشحن إصداراً أحدث من iOS. حدِّث النظام، ثم أعد فتح DisinfaX."
          }
        },
        "ar_XB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب عمليات الشحن إصداراً أحدث من iOS. حدِّث النظام، ثم أعد فتح DisinfaX."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টপ-আপৰ বাবে iOS ৰ নতুন সংস্কৰণ প্ৰয়োজন। আপডেট কৰক, তাৰ পিছত DisinfaX পুনৰ খোলক।"
          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recargues requieren una versión más recién d'iOS. Anova, y dempués abri otra vegada DisinfaX."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doldurmalar üçün iOS-un daha yeni versiyası tələb olunur. Yeniləyin, sonra DisinfaX-i yenidən açın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для папаўненняў патрэбна больш новая версія iOS. Абнавіце сістэму, а потым зноў адкрыйце DisinfaX."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарежданията изискват по-нова версия на iOS. Актуализирайте, след което отворете DisinfaX отново."
          }
        },
        "bh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टॉप-अप के लिए iOS के नए संस्करण की आवश्यकता है। अपडेट करें, फिर DisinfaX को फिर से खोलें।"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টপ-আপের জন্য iOS-এর নতুন সংস্করণ প্রয়োজন। আপডেট করুন, তারপর DisinfaX আবার খুলুন।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar c'hargadennoù a c'houlenn ur stumm nevesoc'h eus iOS. Hizivait, ha goude digorit DisinfaX en-dro."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadopune zahtijevaju noviju verziju iOS-a. Ažurirajte, a zatim ponovno otvorite DisinfaX."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recàrregues requereixen una versió més recent d'iOS. Actualitza, i després torna a obrir DisinfaX."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagkinahanglan ang mga singil og mas bag-ong bersyon sa iOS. I-update, unya ablihi og balik ang DisinfaX."
          }
        },
        "ckb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پڕکردنەوەکان پێویستیان بە وەشانێکی نوێتری iOS هەیە. نوێ بکەرەوە، پاشان DisinfaX دووبارە بکەرەوە."
          }
        },
        "co" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E ricariche necessitanu una versione più nova d'iOS. Attualizate, dopu apre torna DisinfaX."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobíjení vyžaduje novější verzi iOS. Aktualizujte a poté znovu otevřete DisinfaX."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae ail-lenwi angen fersiwn newydd o iOS. Diweddarwch, yna ailagor DisinfaX."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opfyldninger kræver en nyere version af iOS. Opdatér, og genåbn derefter DisinfaX."
          }
        },
        "de" : {
