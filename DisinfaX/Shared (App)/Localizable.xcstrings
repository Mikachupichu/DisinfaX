        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щёлкните правой кнопкой мыши по выделенному тексту и выберите Проверить (работает и на невыделенном тексте)."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kanda ku rufunguzo rw'iburyo ku nyandiko yahiswemo hanyuma uhitemo Genzura (bikorera no ku nyandiko itahiswemo)."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چونڊيل متن تي رائيٽ ڪلڪ ڪريو ۽ تصديق چونڊيو (نه چونڊيل متن تي پڻ ڪم ڪري ٿو)."
          }
        },
        "sh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknite desnim tasterom na odabrani tekst i odaberite Provera (radi i na tekstu koji nije odabran)."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "තෝරාගත් පෙළ මත දකුණු ක්ලික් කර පරීක්ෂාව තෝරන්න (තෝරා නොගත් පෙළ මතද ක්‍රියා කරයි)."
