        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "እንደገና {1} ን ይንኩ እና ብቅ ባይ መስኮቱን ለመክፈት {2} DisinfaX ን ይምረጡ።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna a tocar {1} y escull {2} DisinfaX pa ubrir a finestra emerchent."
