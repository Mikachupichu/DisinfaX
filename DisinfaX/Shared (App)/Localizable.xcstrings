        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengklik %@ mendedahkan dakwaan dan akan mengenakan caj pada baki anda"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikklikkja %@ turi l-allegazzjonijiet u titnaqqas somma mill-bilanċ tiegħek"
