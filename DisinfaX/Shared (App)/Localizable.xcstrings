        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sika a wɔde bɛtɔ mu no hia macOS foforo. Yɛ update, ɛno akyi bue DisinfaX bio."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "መሙላቶች የ macOS አዲስ ስሪት ይፈልጋሉ። ያዘምኑ፣ ከዚያ DisinfaX ን እንደገና ይክፈቱ።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As recargas requieren una versión mas nueva de macOS. Esviella, e dimpués ubre de nuevo DisinfaX."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب عمليات الشحن إصداراً أحدث من macOS. حدِّث النظام، ثم أعد فتح DisinfaX."
          }
        },
        "ar_XB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب عمليات الشحن إصداراً أحدث من macOS. حدِّث النظام، ثم أعد فتح DisinfaX."
