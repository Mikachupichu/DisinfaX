        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neɣ sit s ufus ayeffus ɣef uḍris yettwafren syin tferneḍ Senqed (yetteddu daɣen ɣef uḍris ur nettwafern ara)."
