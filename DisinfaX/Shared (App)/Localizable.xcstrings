        "fy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It stik foar de tekst, allinnich brûkt om te bepalen wêr't in losse bewearing nei ferwiist. Wurdt sels nea kontrolearre."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An sliocht roimh an téacs, a úsáidtear amháin chun a shonrú cad a thagraíonn éileamh lom dó. Ní dhéantar é féin a sheiceáil riamh."
          }
        },
        "gd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An earrann roimh an teacsa, air a cleachdadh a-mhàin gus soilleireachadh dè a tha tagradh lom a' toirt iomradh air. Cha tèid a sgrùdadh fhèin a-riamh."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasaxe anterior ao texto, usada só para aclarar a que se refire unha afirmación illada. Nunca se verifica por si mesma."
          }
        },
        "gn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe jehaipyre mboyve oĩva, ojeporu añónte ojeikuaa hag̃ua mba'érepa oñeñe'ẽ peteĩ mba'e oje'e va'ekue. Ndojehechakuaái hese."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ટેક્સ્ટ પહેલાંનો ભાગ, જે ફક્ત એ સ્પષ્ટ કરવા માટે વપરાય છે કે એકલ દાવો શું સંદર્ભિત કરે છે. તેની જાતે ક્યારેય ફેક્ટ-ચેક કરવામાં આવતી નથી."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sashin da ke kafin rubutun, ana amfani da shi kawai don gano abin da wata da'awa mara bayani ke nufi. Ba a taɓa bincika shi ba."
          }
        },
        "haw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka ʻāpana ma mua o ke kikokikona, i hoʻohana ʻia wale nō e wehewehe i ka mea e kuhikuhi ʻia e kekahi ʻōlelo pōkole. ʻAʻole loa e hōʻoia ʻia ʻo ia iho."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקטע שלפני הטקסט, המשמש רק כדי לקבוע למה מתייחסת טענה בודדת. הוא עצמו לעולם אינו נבדק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट से पहले का अंश, जिसका उपयोग केवल यह समझने के लिए होता है कि कोई अकेला दावा किस ओर इशारा करता है। इसकी स्वयं कभी तथ्य-जाँच नहीं की जाती।"
          }
        },
        "hmn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ntu ntawv ua ntej tsab ntawv, tsuas yog siv los qhia tias ib qho lus tshaj tawm xwb tab tom hais txog dab tsi. Nws tus kheej yeej tsis raug tshawb xyuas."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odlomak prije teksta, služi samo za razrješavanje na što se odnosi samostalna tvrdnja. Nikada se ne provjerava."
          }
        },
        "hsb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wotrězk před tekstom, wužiwa so jenož za to, zo by so wobkedźbowało, na što so samostatne twjerdźenje poćahuje. Sam so nigdy njepřepruwuje."
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasyaj ki anvan tèks la, sèvi sèlman pou detèmine de kisa yon deklarasyon izole ap pale. Yo pa janm verifye li menm."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szöveg előtti részlet, amely csak azt tisztázza, mire utal egy önálló állítás. Maga soha nem esik tényellenőrzés alá."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տեքստից առաջ ընկած հատվածը, օգտագործվում է միայն հասկանալու համար, թե ինչի է վերաբերում առանձին պնդումը: Ինքը երբեք չի ստուգվում:"
          }
        },
        "ia" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le passage ante le texto, usate solmente pro resolver a que un assertion isolate se refere. Illo mesme nunca es verificate."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagian sebelum teks, hanya digunakan untuk menentukan apa yang dirujuk oleh klaim tunggal. Bagian ini sendiri tidak pernah diperiksa faktanya."
          }
        },
        "ig" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akụkụ dị n'ihu ederede ahụ, a na-eji ya naanị iji chọpụta ihe otu nkwupụta na-ezo aka na ya. A naghị enyocha ya n'onwe ya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textinn á undan textanum, notaður aðeins til að ákvarða hvað sjálfstæð fullyrðing vísar til. Hann er aldrei staðreyndaskoðaður sjálfur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il passaggio prima del testo, usato solo per chiarire a cosa si riferisce un'affermazione isolata. Non viene mai verificato."
