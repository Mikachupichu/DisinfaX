        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немесе таңдалған мәтінді тінтуірдің оң жақ түймесімен басып, Тексеру таңдаңыз (таңдалмаған мәтінде де жұмыс істейді)."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ឬចុចស្តាំលើអត្ថបទដែលបានជ្រើសរើស ហើយជ្រើសរើស ត្រួតពិនិត្យ (ដំណើរការផងដែរលើអត្ថបទដែលមិនបានជ្រើសរើស)។"
