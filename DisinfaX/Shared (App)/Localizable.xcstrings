        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настана грешка од наша страна. Обидете се повторно за момент."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഞങ്ങളുടെ ഭാഗത്ത് ഒരു പിശക് സംഭവിച്ചു. അൽപ്പസമയത്തിനുള്ളിൽ വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бидний талд алдаа гарлаа. Хэсэг хугацааны дараа дахин оролдоно уу."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आमच्या बाजूने त्रुटी आली. कृपया थोड्या वेळाने पुन्हा प्रयत्न करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuatu tidak kena di pihak kami. Sila cuba lagi sebentar lagi."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seħħ żball min-naħa tagħna. Jekk jogħġbok erġa' pprova wara ftit."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကျွန်ုပ်တို့ဘက်တွင် အမှားတစ်ခု ဖြစ်ခဲ့ပါသည်။ ခဏစောင့်ပြီး ထပ်စမ်းကြည့်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe gikk feil på vår side. Prøv igjen om et øyeblikk."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हाम्रो तर्फबाट त्रुटि भयो। कृपया केही समयपछि फेरि प्रयास गर्नुहोस्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is iets misgegaan aan onze kant. Probeer het over een moment opnieuw."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noko gjekk feil på vår side. Prøv igjen om ei lita stund."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuto lachitika kumbali kwathu. Chonde yesani kachiwiri patapita kanthawi."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dogoggorri gama keenyaan uumameera. Maaloo yeroo xiqqoo booda deebi'ii yaali."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆମ ପକ୍ଷରୁ ଏକ ତ୍ରୁଟି ହୋଇଛି। ଦୟାକରି କିଛି ସମୟ ପରେ ପୁନଃ ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਾਡੇ ਪਾਸੇ ਤੋਂ ਇੱਕ ਗੜਬੜ ਹੋ ਗਈ। ਕਿਰਪਾ ਕਰਕੇ ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystąpił błąd z naszej strony. Spróbuj ponownie za chwilę."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زموږ په لور کې یوه ستونزه رامنځته شوه. لږ وروسته بیا هڅه وکړئ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro do nosso lado. Tente novamente dentro de momentos."
          }
        },
        "pt_BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro do nosso lado. Tente novamente dentro de momentos."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocorreu um erro do nosso lado. Tente novamente dentro de momentos."
          }
        },
        "qu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ñuqaykuq ladunchikpi pantay karqan. Ama hina kaspa, hukmanta ruway huk chika tiempo qhipaman."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin nossa vart è succedì in error. Emprova per plaschair anc ina giada après in mument."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A apărut o eroare din partea noastră. Încearcă din nou peste puțin timp."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На нашей стороне произошла ошибка. Повторите попытку через некоторое время."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habaye ikibazo ku ruhande rwacu. Nyamuneka ongera ugerageze mu kanya gato."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسان جي پاسي کان هڪ خرابي پيش آئي. ٿوري دير بعد ٻيهر ڪوشش ڪريو."
          }
        },
        "sh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Došlo je do greške s naše strane. Pokušajte ponovo za trenutak."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අපගේ පැත්තෙන් දෝෂයක් සිදු විය. මොහොතකින් නැවත උත්සාහ කරන්න."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na našej strane nastala chyba. Skúste to znova za chvíľu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na naši strani je prišlo do napake. Poskusite znova čez trenutek."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tupu se faʻafitauli i le itu o matou. Faamolemole toe taumafai i se taimi laititi."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chikanganiso chaitika kudivi redu. Ndapota edza zvakare mushure mekanguva."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khalad ayaa ka dhacay dhinaceenna. Fadlan wax yar ka dib mar kale isku day."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ndodhi një gabim nga ana jonë. Provo përsëri pas pak."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дошло је до грешке са наше стране. Покушајте поново за тренутак."
          }
        },
        "st" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phoso e hlahile lehlakoreng la rona. Ka kopo leka hape kamora nakwana."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aya kasalahan ti pihak kami. Mangga cobian deui sakedap."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något gick fel på vår sida. Försök igen om en liten stund."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitilafu ilitokea kwa upande wetu. Tafadhali jaribu tena baada ya muda mfupi."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "எங்கள் பக்கத்தில் ஒரு பிழை ஏற்பட்டது. சிறிது நேரத்தில் மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మా వైపు నుండి ఒక లోపం సంభవించింది. దయచేసి కొద్దిసేపటి తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дар тарафи мо хатогӣ рух дод. Лутфан пас аз лаҳзае боз кӯшиш кунед."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกิดข้อผิดพลาดในระบบของเรา กรุณาลองใหม่อีกครั้งในอีกสักครู่"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ካብ ወገንና ጌጋ ተፈጢሩ። በጃኻ ድሕሪ ሓጺር ግዜ ደጊምካ ፈትን።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biziň tarapymyzdan ýalňyşlyk ýüze çykdy. Az wagtdan soň gaýtadan synanyşyň."
          }
        },
        "tn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phoso e diragetse mo lotlheng lwa rona. Tsweetswee leka gape mo lobakanyaneng."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naʻe hoko ha fehalaaki ʻi hotau tafaʻaki. Kātaki toe feinga ʻi ha taimi siʻi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bizim tarafımızda bir hata oluştu. Lütfen bir süre sonra tekrar deneyin."
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безнең тарафта хата килеп чыкты. Бераздан тагын бер тапкыр сынап карагыз."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بىز تەرەپتە بىر خاتالىق يۈز بەردى. ئازراق ۋاقىتتىن كېيىن قايتا سىناڭ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На нашому боці сталася помилка. Спробуйте ще раз трохи згодом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہماری طرف سے ایک خرابی پیش آئی۔ تھوڑی دیر بعد براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bizning tomonimizda xatolik yuz berdi. Bir oz vaqtdan so'ng qayta urinib ko'ring."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xảy ra lỗi ở phía chúng tôi. Vui lòng thử lại sau một chút."
          }
        },
        "wa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ene aroke a arivé di nosse costé. S' i vs plait, rissayîz dins on moumint."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kwenzeke impazamo ngasecaleni kwethu. Nceda uzame kwakhona kungekudala."
          }
        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אַ טעות איז געשען אויף אונדזער זײַט. ביטע פּרוּווט נאָך אַ מאָל אין אַ מינוט."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Àṣìṣe kan ṣẹlẹ̀ ní ẹ̀gbẹ́ wa. Jọ̀wọ́ tún gbìyànjú láìpẹ́."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们这边出现了问题，请稍后重试。"
          }
        },
        "zh_CN" : {
          "stringUnit" : {
