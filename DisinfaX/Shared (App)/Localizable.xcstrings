        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ពេលដែលប្រកាសត្រូវបានសរសេរ ឬកែចុងក្រោយ៖ ឆ្នាំ (2020) ខែ (2020-04) ឬកាលបរិច្ឆេទ (2020-04-07)។ ការអះអាងរបស់វាត្រូវវិនិច្ឆ័យតាមកាលបរិច្ឆេទនោះ ជាជាងថ្ងៃនេះ។"
