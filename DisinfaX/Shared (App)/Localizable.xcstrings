        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການຄລິກ %@ ຈະເປີດເຜີຍຄໍາກ່າວອ້າງ ແລະ ຈະຄິດຄ່າໃຊ້ຈ່າຍຈາກຍອດເງິນຂອງທ່ານ"
