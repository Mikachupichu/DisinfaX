        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny andalana aorian'ny lahatsoratra, ampiasaina fotsiny hamantarana izay tondroin'ny filazana tsotra. Tsy voadinika mihitsy ny tenany."
