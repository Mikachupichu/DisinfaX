        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstile eelnev lõik, mida kasutatakse ainult selleks, et teha kindlaks, millele üksikväide viitab. Seda ennast ei kontrollita kunagi."
