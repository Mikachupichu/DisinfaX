    "Payment complete. Return to Safari and open the DisinfaX popup to see your updated balance." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betaling voltooi. Gaan terug na Safari en open die DisinfaX-opspringvenster om jou bygewerkte balans te sien."
          }
        },
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sika a wotua no awie. San kɔ Safari na bue DisinfaX pop-up na hwɛ wo kontuo foforo no."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ክፍያ ተጠናቅቋል። ዘመናዊ የተደረገውን ቀሪ ሂሳብዎን ለማየት ወደ Safari ይመለሱ እና የDisinfaX ብቅ ባይ መስኮት ይክፈቱ።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pago completato. Torna ta Safari e ubre a finestra emerchent de DisinfaX pa veyer lo tuyo saldo esviellato."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت عملية الدفع. عد إلى Safari وافتح النافذة المنبثقة لـ DisinfaX لرؤية رصيدك المحدَّث."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পৰিশোধ সম্পূৰ্ণ হ'ল। আপোনাৰ আপডেট কৰা বেলেঞ্চ চাবলৈ Safari লৈ উভতি যাওক আৰু DisinfaX পপআপ খোলক।"
          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagu completáu. Vuelvi a Safari y abri la ventana emerxente de DisinfaX pa ver el to saldu anovao."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödəniş tamamlandı. Yenilənmiş balansınızı görmək üçün Safari-yə qayıdın və DisinfaX pop-up pəncərəsini açın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аплата завершана. Вярніцеся ў Safari і адкрыйце ўсплывальнае акно DisinfaX, каб убачыць абноўлены баланс."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плащането е завършено. Върнете се в Safari и отворете изскачащия прозорец на DisinfaX, за да видите актуализирания си баланс."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পেমেন্ট সম্পন্ন হয়েছে। আপনার আপডেট করা ব্যালেন্স দেখতে Safari-তে ফিরে যান এবং DisinfaX পপআপ খুলুন।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paeamant echu. Distroit da Safari ha digorit prenestr diflugellañ DisinfaX evit gwelet ho koust hizivaet."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaćanje dovršeno. Vratite se na Safari i otvorite DisinfaX skočni prozor kako biste vidjeli ažurirano stanje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagament completat. Torna a Safari i obre la finestra emergent de DisinfaX per veure el teu saldo actualitzat."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakumpleto na ang bayad. Balik sa Safari ug ablihi ang DisinfaX popup aron makita ang imong na-update nga balanse."
