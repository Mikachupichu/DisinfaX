    "Top-ups need a newer version of macOS. Update, then reopen DisinfaX." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oplaaie benodig 'n nuwer weergawe van macOS. Werk by, en open dan DisinfaX weer."
