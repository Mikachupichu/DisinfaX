        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aḥric deffir uḍris, yettwasxdem kan akken ad tban acu i wumi yerra tixwal tusridt. Ur yettwasenqed qaṣṣ i netta."
