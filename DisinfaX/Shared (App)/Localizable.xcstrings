        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isiqendu esisemva kombhalo; sisetyenziselwa kuphela ukucacisa ukuba ibango elilodwa libhekisa kwintoni. Ngokwaso aliqinisekiswa nanini."
