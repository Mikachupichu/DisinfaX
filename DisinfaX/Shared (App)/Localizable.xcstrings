        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure fai clic con il tasto destro sul testo selezionato e scegli Verifica (funziona anche sul testo non selezionato)."
          }
        },
        "it_CH" : {
          "stringUnit" : {
