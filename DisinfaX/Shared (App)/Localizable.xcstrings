        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagean sadurunge teks, mung digunakake kanggo nemtokake apa sing dirujuk dening pratelan tunggal. Bagean iki dhewe ora tau dipriksa faktane."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ტექსტამდე მდებარე ნაწყვეტი; გამოიყენება მხოლოდ იმის დასადგენად, რას ეხება ცალკე მტკიცება. თავად არასოდეს მოწმდება."
          }
        },
        "kab" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aḥric uqbel uḍris, yettwasxdem kan akken ad tban acu i wumi yerra tixwal tusridt. Ur yettwasenqed qaṣṣ i netta."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мәтінге дейінгі үзінді, тек жалаң тұжырымның нені білдіретінін анықтау үшін пайдаланылады. Өзі ешқашан тексерілмейді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "វគ្គមុនអត្ថបទ ប្រើតែដើម្បីកំណត់ថាតើការអះអាងទទេៗសំដៅលើអ្វី។ មិនដែលផ្ទៀងផ្ទាត់ខ្លួនឯងឡើយ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪಠ್ಯದ ಮೊದಲಿನ ಆಯ್ದ ಭಾಗ, ಸಂಕ್ಷಿಪ್ತ ಹೇಳಿಕೆ ಯಾವುದನ್ನು ಸೂಚಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ನಿರ್ಧರಿಸಲು ಮಾತ್ರ ಬಳಸಲಾಗುತ್ತದೆ. ಸ್ವತಃ ಎಂದಿಗೂ ಪರಿಶೀಲಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 앞의 구절로, 맨 주장이 무엇을 가리키는지 파악하는 데만 사용됩니다. 그 자체로는 팩트체크되지 않습니다."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beşa beriya nivîsê, tenê ji bo diyarkirina ku îdîayeke tazî çi nîşan dide tê bikar anîn. Tu carî bi xwe nayê verastkirin."
          }
        },
        "ky" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстен мурунку үзүндү, жалаң ырастоо эмнени билдирерин аныктоо үчүн гана колдонулат. Өзү эч качан текшерилбейт."
          }
        },
        "la" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pars ante textum, adhibita tantum ut constet quid sententia nuda significet. Ipsa numquam recensetur."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Passage virum Text, gëtt just benotzt fir ze klären op wat eng nackt Ausso sech bezitt. Gëtt ni selwer faktengecheckt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຫຼາກຄວາມກ່ອນຂໍ້ຄວາມ, ໃຊ້ພຽງເພື່ອກຳນົດວ່າຂໍ້ກ່າວອ້າງເປົ່າຯ ໝາຍເຖິງສິ່ງໃດ. ບໍ່ເຄີຍຖືກກວດສອບຕົວມັນເອງ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstui prieš einanti ištrauka, naudojama tik nustatyti, į ką nurodo plikas teiginys. Pati niekada netikrinama."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragments pirms teksta — izmantots tikai, lai noteiktu, uz ko attiecas kails apgalvojums. Pats nekad netiek pārbaudīts."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ny andalana alohan'ny lahatsoratra, ampiasaina fotsiny hamantarana izay tondroin'ny filazana tsotra. Tsy voadinika mihitsy ny tenany."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te wāhanga i mua i te tuhinga, ka whakamahia noa hei whakatau he aha te kerēme mārakerake e hāngai ana ki a ia. Kāore e manatokona i a ia anō."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пасажот пред текстот, се користи само за да се утврди на што се однесува голо тврдење. Самиот никогаш не се проверува."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ടെക്സ്റ്റിന് മുൻപുള്ള ഭാഗം, വെറും വാദം എന്തിനെയാണ് സൂചിപ്പിക്കുന്നതെന്ന് നിർണ്ണയിക്കാൻ മാത്രം ഉപയോഗിക്കുന്നു. അതിന്റെ ഉള്ളടക്കം ഒരിക്കലും പരിശോധിക്കുന്നില്ല."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстийн өмнөх хэсэг, зөвхөн нүцгэн мэдэгдэл юуг заасныг тодруулахад ашиглана. Өөрөө хэзээ ч шалгагдахгүй."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मजकुराआधीचा उतारा, केवळ नग्न दावा कशाकडे निर्देश करतो हे ठरवण्यासाठी वापरला जातो. स्वतःचे कधीही पडताळणी केली जात नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petikan sebelum teks, digunakan hanya untuk menentukan apa yang dirujuk oleh dakwaan kosong. Ia sendiri tidak pernah disemak fakta."
          }
        },
        "mt" : {
          "stringUnit" : {
