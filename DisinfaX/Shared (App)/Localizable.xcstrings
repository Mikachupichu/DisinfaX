    "Tap the same icon and choose DisinfaX to open the popup." : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op dieselfde ikoon en kies DisinfaX om die opspringvenster te open."
          }
        },
        "ak" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka saa sɛnkyerɛnne no ara na paw DisinfaX na bue pop-up no."
          }
        },
        "am" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ያንኑ አዶ ይንኩ እና ብቅ ባይ መስኮቱን ለመክፈት DisinfaX ን ይምረጡ።"
          }
        },
        "an" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca lo mesmo icono e escull DisinfaX pa ubrir a finestra emerchent."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على الأيقونة نفسها واختر DisinfaX لفتح النافذة المنبثقة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একেটা চিহ্নতে টিপক আৰু পপআপ খুলিবলৈ DisinfaX বাছক।"
          }
        },
        "ast" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca'l mesmu iconu y escueye DisinfaX p'abrir la ventana emerxente."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyni ikona toxunun və pop-up pəncərəsini açmaq üçün DisinfaX-i seçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дакраніцеся да таго ж значка і выберыце DisinfaX, каб адкрыць усплывальнае акно."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докоснете същата икона и изберете DisinfaX, за да отворите изскачащия прозорец."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একই আইকনে ট্যাপ করুন এবং পপআপ খুলতে DisinfaX বেছে নিন।"
          }
        },
        "br" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stokit war an hevelep arlun ha dibabit DisinfaX evit digeriñ ar prenestr diflugellañ."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite istu ikonu i odaberite DisinfaX kako biste otvorili skočni prozor."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca la mateixa icona i tria DisinfaX per obrir la finestra emergent."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-tap ang sama nga icon ug pilia ang DisinfaX aron ablihan ang popup."
          }
        },
        "ckb" : {
