        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai arī noklikšķiniet ar peles labo pogu uz atlasīto tekstu un izvēlieties Pārbaudīt (darbojas arī ar neatzīmētu tekstu)."
          }
        },
        "mg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na kitiho amin'ny bokotra havanana amin'ny lahatsoratra voafidy dia safidio ny Manamarina (miasa koa amin'ny lahatsoratra tsy voafidy)."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rānei, pāwhiritia te pāwhiri-matau ki te kuputuhi kua tōia, ka kōwhiri i a Arotake (ka mahi hoki ki te kuputuhi kāore anō kia tōia)."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или кликнете со десното копче на избраниот текст и изберете Проверка (работи и на неизбран текст)."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അല്ലെങ്കിൽ തിരഞ്ഞെടുത്ത ടെക്സ്റ്റിൽ റൈറ്റ്-ക്ലിക്ക് ചെയ്ത് പരിശോധന തിരഞ്ഞെടുക്കുക (തിരഞ്ഞെടുക്കാത്ത ടെക്സ്റ്റിലും പ്രവർത്തിക്കും)."
          }
        },
        "mn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эсвэл сонгосон текст дээр хулганы баруун товчийг дараад Шалгалт-г сонгоно уу (сонгоогүй текст дээр ч ажиллана)."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किंवा निवडलेल्या मजकुरावर राइट-क्लिक करा आणि तपासणी निवडा (न निवडलेल्या मजकुरावरही काम करते)."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau klik kanan teks yang dipilih dan pilih Pemeriksaan (juga berfungsi pada teks yang tidak dipilih)."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jew ikklikkja bil-lemin fuq it-test magħżul u agħżel Verifika (jaħdem ukoll fuq test mhux magħżul)."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သို့မဟုတ် ရွေးထားသော စာသားပေါ်တွင် ညာကလစ်နှိပ်ပြီး စစ်ဆေးခြင်း ကို ရွေးပါ (မရွေးထားသော စာသားတွင်လည်း အလုပ်လုပ်ပါသည်)။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller høyreklikk på den markerte teksten og velg Kontroll (fungerer også på tekst som ikke er markert)."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वा चयन गरिएको पाठमा राइट-क्लिक गरी जाँच छनौट गर्नुहोस् (नचयन गरिएको पाठमा पनि काम गर्छ)।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of klik met de rechtermuisknop op de geselecteerde tekst en kies Controleren (werkt ook op niet-geselecteerde tekst)."
          }
        },
        "nn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller høyreklikk på den markerte teksten og velg Kontroll (fungerer også på tekst som ikke er markert)."
          }
        },
        "ny" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapena dinani kumanja pa zolemba zosankhidwa ndikusankha Kuwunika (imagwiranso ntchito pa zolemba zomwe sizinasankhidwe)."
          }
        },
        "om" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yookaan barruu filatame irratti mirga tuqiitii Mirkaneessa filadhu (barruu hin filatamne irrattis ni hojjeta)."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କିମ୍ବା ଚୟନିତ ପାଠ୍ୟ ଉପରେ ରାଇଟ୍-କ୍ଲିକ୍ କରି ଯାଞ୍ଚ ଚୟନ କରନ୍ତୁ (ଅଣଚୟନିତ ପାଠ୍ୟ ଉପରେ ମଧ୍ୟ କାମ କରେ)।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਾਂ ਚੁਣੇ ਗਏ ਟੈਕਸਟ 'ਤੇ ਸੱਜਾ ਕਲਿੱਕ ਕਰੋ ਅਤੇ ਤੱਥ ਜਾਂਚ ਚੁਣੋ (ਬਿਨਾਂ ਚੁਣੇ ਟੈਕਸਟ 'ਤੇ ਵੀ ਕੰਮ ਕਰਦਾ ਹੈ)।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz też kliknąć prawym przyciskiem myszy na zaznaczonym tekście i wybrać Weryfikacja (działa też na niezaznaczonym tekście)."
          }
        },
        "ps" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یا په ټاکل شوي متن ښي کلیک وکړئ او تایید وټاکئ (په ناټاکل شوي متن هم کار کوي)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou clica com o botão direito no texto selecionado e escolhe Verificar (também funciona em texto não selecionado)."
          }
        },
        "pt_BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou clique com o botão direito no texto selecionado e escolha Verificar (também funciona com texto não selecionado)."
          }
        },
        "pt_PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou clica com o botão direito no texto selecionado e escolhe Verificar (também funciona em texto não selecionado)."
          }
        },
        "qu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utqaylla paña butunta qillqa akllasqapi tuqyay hinaspa Chaninchay akllay (mana akllasqa qillqapipas llamk'anmi)."
          }
        },
        "rm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U fa in clic cun il buttun dretg sin il text selecziunà e tscherna Verificaziun (funcziunescha er sin text betg selecziunà)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau fă clic dreapta pe textul selectat și alege Verifică (funcționează și pe text neselectat)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или щёлкните правой кнопкой мыши по выделенному тексту и выберите Проверить (работает и на невыделенном тексте)."
          }
        },
        "rw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cyangwa kanda ku rufunguzo rw'iburyo ku nyandiko yahiswemo hanyuma uhitemo Genzura (bikorera no ku nyandiko itahiswemo)."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يا چونڊيل متن تي رائيٽ ڪلڪ ڪريو ۽ تصديق چونڊيو (نه چونڊيل متن تي پڻ ڪم ڪري ٿو)."
          }
        },
        "sh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili kliknite desnim tasterom na odabrani tekst i odaberite Provera (radi i na tekstu koji nije odabran)."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "නැතහොත් තෝරාගත් පෙළ මත දකුණු ක්ලික් කර පරීක්ෂාව තෝරන්න (තෝරා නොගත් පෙළ මතද ක්‍රියා කරයි)."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alebo kliknite pravým tlačidlom na vybratý text a vyberte Overiť (funguje aj na nevybratom texte)."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali kliknite z desno tipko miške na izbrano besedilo in izberite Razkrij (deluje tudi na neizbranem besedilu)."
          }
        },
        "sm" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe, kiliki i le kiʻi taumatau i le tusitusiga ua filifilia ona filifili lea o le Fa'aali (e aoga foʻi i le tusitusiga e leʻi filifilia)."
          }
        },
        "sn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kana baya neki yesu kurudyi pachinyorwa chasarudzwa wobva wasarudza Ongorora chokwadi (inoshandawo pachinyorwa chisina kusarudzwa)."
          }
        },
        "so" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ama taabo badhanka midig ee qoraalka la doortay ka dibna dooro Xaqiiji (waxay sidoo kale ka shaqeysaa qoraal aan la dooran)."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ose kliko me të djathtën mbi tekstin e zgjedhur dhe zgjidh Disinfakto (funksionon edhe për tekst të pazgjedhur)."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или кликните десним тастером миша на изабрани текст и изаберите Откриј (ради и на неизбраном тексту)."
          }
        },
        "st" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapa tobetsa ho konopo e ka ho le letona ya mongolo o khethiloeng ebe u khetha Hlahloba (e sebetsa le mongolong o sa khethoang)."
          }
        },
        "su" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atanapi klik-katuhu téks anu dipilih teras pilih Pariksa (ogé tiasa dianggo dina téks anu henteu dipilih)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller högerklicka på den markerade texten och välj Disinfact (fungerar även på text som inte är markerad)."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au bofya kwa kitufe cha kulia kwenye maandishi yaliyochaguliwa kisha uchague Disinfact (inafanya kazi pia kwenye maandishi ambayo hayajachaguliwa)."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அல்லது தேர்ந்தெடுத்த உரையில் வலது கிளிக் செய்து உண்மை சரிபார்ப்பு தேர்ந்தெடுக்கவும் (தேர்ந்தெடுக்காத உரையிலும் வேலை செய்யும்)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లేదా ఎంచుకున్న వచనంపై కుడి-క్లిక్ చేసి వాస్తవ తనిఖీను ఎంచుకోండి (ఎంచుకోని వచనంపైనా పని చేస్తుంది)."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ё бо тугмаи рости муш дар матни интихобшуда зер кунед ва Ошкор кардан-ро интихоб кунед (дар матни интихобнашуда ҳам кор мекунад)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หรือคลิกขวาที่ข้อความที่เลือกแล้วเลือก ตรวจสอบข้อเท็จจริง (ใช้ได้กับข้อความที่ไม่ได้เลือกด้วย)"
          }
        },
        "ti" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ወይ ኣብቲ ተመሪጹ ዘሎ ጽሑፍ ቀኝ-ክሊክ ጠውቕ እሞ ግለጽ ምረጽ (ኣብ ዘይተመርጸ ጽሑፍ እውን ይሰርሕ)።"
          }
        },
        "tk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýa-da saýlanan tekste sag düwmä basyň we Barla saýlaň (saýlanmadyk tekstde hem işleýär)."
          }
        },
        "tn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapa tobetsa ka konopo ya moja e e kafa mo le letona mo mokwalong o o tlhophilweng mme o tlhophe Tlhatlhoba (e dira gape mo mokwalong o o sa tlhophiwang)."
          }
        },
        "to" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe tuki e kiʻi toʻomataʻu ʻi he tohi kuo fili pea fili ʻa e Fakahā (ʻoku ngāue ʻi he tohi ʻoku teʻeki fili)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veya seçili metne sağ tıklayıp Doğrula öğesini seçin (seçili olmayan metinde de çalışır)."
          }
        },
        "tt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Яки сайланган текстка уң төймә белән басып, Ачыклау сайлагыз (сайланмаган текстта да эшли)."
          }
        },
        "ug" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ياكى تاللانغان تېكىستنى ئوڭ چېكىپ ئاشكارىلاش نى تاللاڭ (تاللانمىغان تېكىستكىمۇ ئىشلەيدۇ)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або клацніть правою кнопкою миші на виділеному тексті та виберіть Перевірити (працює і на невиділеному тексті)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یا منتخب شدہ متن پر رائٹ کلک کریں اور تصدیق کریں منتخب کریں (غیر منتخب متن پر بھی کام کرتا ہے)۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yoki tanlangan matnni sichqonchaning o'ng tugmasi bilan bosing va Tekshirishni tanlang (tanlanmagan matnda ham ishlaydi)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoặc nhấp chuột phải vào văn bản đã chọn và chọn Kiểm Chứng (cũng hoạt động trên văn bản chưa được chọn)."
          }
        },
        "wa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou féjhoz on clitch droet so l' tecse tchoezi eyet tchoezixhoz Verifyî (ça rote eto so do tecse ki n' est nén tchoezi)."
          }
        },
        "xh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okanye cofa ngakwesokunene kumbhalo okhethiweyo uze ukhethe Qinisekisa (ikwasebenza nakumbhalo ongakhethwanga)."
          }
        },
        "yi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אָדער קליקט מיט דער רעכטער קנעפּל אויפֿן אויסגעקליבענעם טעקסט און קלייבט אויס Disinfact (אַרבעט אויך אויף ניט־אויסגעקליבענעם טעקסט)."
          }
        },
        "yo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tàbí tẹ̀ ẹ́ ní ẹ̀gbẹ́ ọ̀tún lórí àkọsílẹ̀ tí a yàn kí o sì yan Ṣàyẹ̀wò (ó tún ṣiṣẹ́ lórí àkọsílẹ̀ tí a kò yàn)."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者右键点按所选文本并选择 事实核查（对未选中的文本同样有效）。"
          }
        },
        "zh_CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者右键点按所选文本并选择 事实核查（对未选中的文本同样有效）。"
          }
        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者右鍵點一下所選文字並選擇 事實查核（對未選取的文字同樣有效）。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或者右鍵點一下所選文字並選擇 事實查核（對未選取的文字同樣有效）。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noma thepha ngakwesokudla kumbhalo okhethiwe bese ukhetha Hlola (kusebenza nakumbhalo ongakhethiwe)."
          }
        }
      }
    },
