        },
        "zh_HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的餘額不足，請儲值後繼續。"
          }
        },
        "zh_TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的餘額不足，請儲值後再繼續。"
          }
