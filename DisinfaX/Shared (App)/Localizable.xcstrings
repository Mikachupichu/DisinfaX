        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang bahaging nauuna sa teksto, ginagamit lamang upang tukuyin kung ano ang tinutukoy ng isang payak na pahayag. Hindi ito kailanman fina-fact-check."
