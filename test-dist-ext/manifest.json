{
  "manifest_version": 3,
  "name": "DisinfaX",
  "description": "Identifies and highlights disinformation in tweets using fast and intelligent research.",
  "version": "1.0.4",
  "icons": {
    "16": "icon/16-gray.png",
    "32": "icon/32-gray.png",
    "48": "icon/48-gray.png",
    "96": "icon/96-gray.png",
    "128": "icon/128-gray.png"
  },
  "default_locale": "en",
  "action": {
    "default_icon": {
      "16": "icon/16-gray.png",
      "32": "icon/32-gray.png",
      "48": "icon/48-gray.png",
      "96": "icon/96-gray.png",
      "128": "icon/128-gray.png"
    },
    "default_title": "DisinfaX",
    "default_popup": "popup.html"
  },
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://en.wikipedia.org/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "disinfax@disinfax.app"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "content-scripts/capture.js"
      ],
      "world": "MAIN"
    },
    {
      "matches": [
        "*://x.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "content-scripts/relay.js"
      ]
    }
  ]
}